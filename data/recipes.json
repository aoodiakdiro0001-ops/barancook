        "en": {
          "title": "Turkish Pilav with Pine Nuts",
          "description": "Turkish rice — every grain coated in butter and studded with pine nuts and currants.",
          "ingredients": [
            {
              "name": "rice",
              "amount": 2,
              "unit": "cups"
            },
            {
              "name": "butter",
              "amount": 3,
              "unit": "tbsp"
            },
            {
              "name": "pine nuts",
              "amount": 2,
              "unit": "tbsp"
            },
            {
              "name": "currants",
              "amount": 2,
              "unit": "tbsp"
            },
            {
              "name": "chicken broth",
              "amount": 4,
              "unit": "cups"
            }
          ],
          "steps": [
            {
              "step_number": 1,
              "instruction": "Soak rice in hot water for 20 minutes; drain well."
            },
            {
              "step_number": 2,
              "instruction": "Toast pine nuts in butter until golden."
            },
            {
              "step_number": 3,
              "instruction": "Add the rice and stir to coat every grain."
            },
            {
              "step_number": 4,
              "instruction": "Pour hot chicken broth, cover, simmer 20 minutes on low."
            },
            {
              "step_number": 5,
              "instruction": "Fold in currants right before serving."
