            {
              "step_number": 1,
              "instruction": "انقع الحمّص الجاف في ماء بارد ليلة كاملة (أو استخدم معلّباً مصفّى)."
            },
            {
              "step_number": 2,
              "instruction": "اسلقه مع رشّة بيكربونات الصودا 40 دقيقة حتى يفصخ القشر."
            },
            {
              "step_number": 3,
              "instruction": "أزل القشرة ثم اخفقه في الخالط مع الطحينة والليمون والثوم والملح."
            },
            {
              "step_number": 4,
              "instruction": "أضف ماء السلق تدريجياً حتى القوام الحريري — قدمه بالزيت والبابريكا."
            }
          ],
          "source_note": "وصفة شعبية معروفة عاماً — زُرعت كبذرة محلية بلا رابط خارجي"
        },
        "en": {
          "title": "Hummus with Tahini",
          "description": "Iconic Levantine dish — silky hummus requires peeling the chickpeas after a long simmer.",
          "ingredients": [
            {
              "name": "chickpeas",
              "amount": 2,
              "unit": "cups"
            },
            {
              "name": "tahini",
              "amount": 4,
              "unit": "tbsp"
            },
            {
              "name": "lemon juice",
              "amount": 3,
              "unit": "tbsp"
            },
            {
              "name": "garlic",
              "amount": 2,
              "unit": "count"
            },
            {
              "name": "salt",
              "amount": 1,
              "unit": "tsp"
            },
            {
              "name": "olive oil",
              "amount": 2,
              "unit": "tbsp"
            }
          ],
          "steps": [
            {
              "step_number": 1,
              "instruction": "Soak dried chickpeas in cold water overnight (or use well-drained canned)."
            },
            {
              "step_number": 2,
              "instruction": "Simmer with a pinch of baking soda for 40 minutes until skins loosen."
            },
            {
              "step_number": 3,
              "instruction": "Peel the skins then blend with tahini, lemon juice, garlic and salt."
            },
            {
              "step_number": 4,
              "instruction": "Add cooking water gradually to a silky texture; finish with olive oil and paprika."
            }
          ],
          "source_note": "Traditional folk recipe — locally seeded, no external URL"
        }
      },
